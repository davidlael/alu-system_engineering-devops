#!/usr/bin/env bash
# Configure a custom 404 error page containing "Ceci n'est pas une page" with HTTP status 404

apt-get update -y
apt-get install nginx -y
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html
sed -i 's#server_name _;#server_name _;\n\n\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\tinternal;\n\t}#' /etc/nginx/sites-available/default
service nginx restart || service nginx reload
