#!/usr/bin/env bash
# Configure Nginx server with a 301 redirection from /redirect_me to YouTube

apt-get update -y
apt-get install nginx -y

# Use a safer sed replacement that targets the server block properly
sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-available/default

# Test Nginx configuration before restarting
nginx -t

service nginx restart || service nginx reload
