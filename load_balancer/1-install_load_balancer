#!/usr/bin/env bash
# Installs HAProxy and load balances web-01 and web-02 using roundrobin
sudo apt-get -y update
sudo apt-get -y install haproxy
sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy

# Remove any previous load balancer block, then add a fresh one
sudo sed -i '/^frontend http_front/,$d' /etc/haproxy/haproxy.cfg
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<'EOF'
frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7379-web-01 18.171.52.4:80 check
    server 7379-web-02 18.171.148.55:80 check
EOF

sudo service haproxy restart
