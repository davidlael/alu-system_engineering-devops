#!/usr/bin/env bash
# Installs and configures HAProxy to load balance web-01 and web-02 with roundrobin
sudo apt-get -y update
sudo apt-get -y install haproxy
sudo sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
if ! grep -q "http_back" /etc/haproxy/haproxy.cfg; then
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<EOF

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7379-web-01 18.171.52.4 check
    server 7379-web-02 18.171.148.55 check
EOF
fi
sudo service haproxy restart
